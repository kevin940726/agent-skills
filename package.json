{
  "name": "agent-skills",
  "private": true,
  "description": "Personal curated agent skills, tracked as a lockfile; installs are global-only.",
  "scripts": {
    "skills:check": "node scripts/sync-skills.mjs --dry-run",
    "skills:sync": "node scripts/sync-skills.mjs --all",
    "skills:list": "npx skills ls -g",
    "skills:retro": "node scripts/skill-retro.mjs",
    "opencode:commands:check": "node scripts/sync-opencode-commands.mjs --dry-run",
    "opencode:commands:sync": "node scripts/sync-opencode-commands.mjs"
  }
}
