# OS / editor
.DS_Store
Thumbs.db
*.swp

# Dependency artifacts (vendored skills should stay self-contained)
node_modules/

# CLI install output (per-machine state, not repo content):
# .agents/ is where the CLI unpacks skills, .claude/ holds symlinks into it.
# skills-lock.json is the curated pointer list and IS committed; those are not.
.agents/
.claude/

# Python bytecode (some skills ship scripts)
__pycache__/
*.pyc

# Secrets (never commit; keep .env.example as the documented shape)
.env
.env.*
!.env.example
